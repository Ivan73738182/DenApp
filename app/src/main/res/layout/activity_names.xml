<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:padding="24dp"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/themeBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙"
            android:textSize="22sp"
            android:backgroundTint="#1E1E2E"
            android:textColor="#FFFFFF"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="10dp"
            app:cornerRadius="24dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="КРЕСТИКИ"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="и нолики"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="40dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E1E2E"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="X"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#2196F3" />

            <EditText
                android:id="@+id/playerXInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Имя игрока X"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="18sp"
                android:padding="10dp"
                android:layout_marginStart="12dp"
                android:backgroundTint="#2196F3"
                android:inputType="text"
                android:maxLength="15" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E1E2E"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="O"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#00BCD4" />

            <EditText
                android:id="@+id/playerOInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Имя игрока O"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="18sp"
                android:padding="10dp"
                android:layout_marginStart="12dp"
                android:backgroundTint="#00BCD4"
                android:inputType="text"
                android:maxLength="15" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/startTwoPlayersBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎮  НАЧАТЬ ИГРУ"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6A1B9A"
        android:padding="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="18dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="— или —"
        android:textColor="#666666"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/startComputerBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🤖  ИГРАТЬ С КОМПЬЮТЕРОМ"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2196F3"
        android:padding="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="18dp" />

<Button
    android:id="@+id/trainingBtn"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="🎓  ОБУЧЕНИЕ"
    android:textSize="15sp"
    android:textStyle="bold"
    android:textColor="#FFFFFF"
    android:backgroundTint="#FF9800"
    android:padding="16dp"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    app:cornerRadius="18dp" />

</LinearLayout>
