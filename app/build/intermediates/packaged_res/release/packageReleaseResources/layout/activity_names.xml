<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Крестики-нолики"
        android:textColor="#2196F3"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Игра на двоих"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <!-- Игрок X -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="X"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#2196F3" />

        <EditText
            android:id="@+id/playerXInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Имя игрока X"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="18sp"
            android:padding="12dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="#2196F3"
            android:inputType="text"
            android:maxLength="15" />
    </LinearLayout>

    <!-- Игрок O -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="O"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#00BCD4" />

        <EditText
            android:id="@+id/playerOInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Имя игрока O"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="18sp"
            android:padding="12dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="#00BCD4"
            android:inputType="text"
            android:maxLength="15" />
    </LinearLayout>

    <!-- Кнопка: играть на двоих -->
    <Button
        android:id="@+id/startTwoPlayersBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="НАЧАТЬ ИГРУ"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2196F3"
        android:padding="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="— или —"
        android:textColor="#666666"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Кнопка: играть с компьютером -->
    <Button
        android:id="@+id/startComputerBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ИГРАТЬ С КОМПЬЮТЕРОМ"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00BCD4"
        android:padding="14dp" />

</LinearLayout>
